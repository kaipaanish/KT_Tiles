{
  // Type-checks the layout engine and the pure photo maths without the DOM library,
  // so any use of document, window or canvas there fails the build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/engine", "src/photo/homography.ts", "src/photo/maskToQuad.ts", "src/photo/pointer.ts"],
  "exclude": ["src/engine/**/*.test.ts", "src/engine/testkit.ts"]
}
