{
  // Type-checks the layout engine, the pure photo maths, the segmentation clean-up and the tile
  // mesh without the DOM library, so any use of document, window or canvas there fails the build.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": [
    "src/engine",
    "src/photo/homography.ts",
    "src/photo/maskToQuad.ts",
    "src/photo/pointer.ts",
    "src/photo/fit.ts",
    "src/photo/lines.ts",
    "src/photo/holes.ts",
    "src/photo/shading.ts",
    "src/ar/surfaceFrame.ts",
    "src/ar/marking.ts",
    "src/ar/depth.ts",
    "src/ar/lighting.ts",
    "src/render/webgl/mesh.ts",
    "src/segment/segmenter.ts",
    "src/segment/classes.ts",
    "src/segment/postprocess.ts",
    "src/segment/segformer.ts",
    "src/segment/fakeSegmenter.ts"
  ],
  "exclude": ["src/engine/**/*.test.ts", "src/engine/testkit.ts"]
}
